{
  "name": "seance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Halloween demo: talk to ghosts on a Ouija board, powered by a Fish Audio voice agent speaking with Drama 3.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.ts",
    "dev": "node --env-file=.env --watch src/server.ts",
    "provision": "node --env-file=.env scripts/provision.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "audition": "node --env-file=.env scripts/audition.ts",
    "check:browser": "node scripts/check-flame.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "1.61.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fastify/static": "~9.3.0",
    "fastify": "^5.12.7"
  }
}
