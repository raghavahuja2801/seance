# Copy to .env and fill in. Never commit .env.
# Read server-side only; never sent to the browser.

# Fish Audio API key. Agent minutes ($0.06/min) bill to this key's workspace.
FISH_API_KEY=

# Printed by `npm run provision`. The server uses it to create sessions.
SEANCE_AGENT_ID=

# HTTP port for the local app.
PORT=8790
